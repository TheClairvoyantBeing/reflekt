rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Rules for journal entries collection
    match /entries/{entryId} {
      // Allow reading if the user is the owner of the existing entry
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      
      // Allow creating only if user sets their own user_id and mandatory fields exist
      allow create: if isAuthenticated() 
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.content is string;
      
      // Allow updating only if the entry belongs to the user and user_id is not mutated
      allow update: if isAuthenticated()
                    && resource.data.user_id == request.auth.uid
                    && request.resource.data.user_id == resource.data.user_id;
                    
      // Allow deletion only if the entry belongs to the user
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
